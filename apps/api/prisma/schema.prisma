generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SignalType {
  KOL_POST
  MENTION_SPIKE
  WHALE_BUY
  VOLUME_SPIKE
}

enum MissionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum Platform {
  X
  TELEGRAM
  DISCORD
}

enum ActionType {
  REPLY
  SHARE
  BOOST
  INVITE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum FeedPostKind {
  KOL_POST
  MENTION
}

model User {
  id           String      @id @default(cuid())
  wallet       String      @unique
  displayName  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  memberships  CommunityMember[]
  submissions  Submission[]
  scores       Score[]
  claims       MissionClaim[]
  shortLinks   ShortLink[]
  pinnedMissions Mission[] @relation("MissionPins")
  checkIns     MissionCheckIn[]
}

model Community {
  id               String               @id @default(cuid())
  name             String
  ticker           String
  description      String?
  chainId          String?
  contractAddress  String?
  dexUrl           String?
  imageUrl         String?
  xCommunityUrl    String?
  xCommunityId     String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  members          CommunityMember[]
  signals          Signal[]
  missions         Mission[]
  scoreEntries     Score[]
  leaderboardSnaps LeaderboardSnapshot[]
  shortLinks       ShortLink[]
  kolWatches       KolWatch[]
  feedPosts        FeedPost[]

  @@unique([chainId, contractAddress])
}

model KolWatch {
  id            String    @id @default(cuid())
  communityId   String
  handle        String
  displayName   String?
  xUserId       String?
  createdAt     DateTime  @default(now())
  lastFetchedAt DateTime?
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  posts         FeedPost[]

  @@unique([communityId, handle])
}

model FeedPost {
  id            String       @id @default(cuid())
  communityId   String
  kolWatchId    String?
  kind          FeedPostKind
  url           String
  authorHandle  String
  authorName    String?
  text          String
  postedAt      DateTime
  notifiedAt    DateTime?
  missionId     String?
  createdAt     DateTime     @default(now())
  community     Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  kolWatch      KolWatch?    @relation(fields: [kolWatchId], references: [id], onDelete: SetNull)
  mission       Mission?     @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@unique([communityId, url])
  @@index([communityId, postedAt])
}

model CommunityMember {
  id           String   @id @default(cuid())
  userId       String
  communityId  String
  role         String   @default("member")
  joinedAt     DateTime @default(now())
  lastActiveAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, role])
}

model Signal {
  id            String      @id @default(cuid())
  communityId   String
  type          SignalType
  severity      Int
  sourceRef     String?
  dedupeKey     String      @unique
  metadata      Json?
  createdAt     DateTime    @default(now())
  community     Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  mission       Mission?
}

model Mission {
  id            String       @id @default(cuid())
  communityId   String
  signalId      String?      @unique
  title         String
  description   String
  status        MissionStatus @default(ACTIVE)
  priority      Priority      @default(MEDIUM)
  urgency       Int           @default(50)
  pinText       String?
  pinnedAt      DateTime?
  pinnedById    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  community     Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  signal        Signal?       @relation(fields: [signalId], references: [id], onDelete: SetNull)
  pinnedBy      User?         @relation("MissionPins", fields: [pinnedById], references: [id], onDelete: SetNull)
  tasks         MissionTask[]
  shortLinks    ShortLink[]
  claims        MissionClaim[]
  checkIns      MissionCheckIn[]
  feedPosts     FeedPost[]
}

model MissionCheckIn {
  id        String   @id @default(cuid())
  missionId String
  userId    String
  createdAt DateTime @default(now())
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
  @@index([missionId])
}

model MissionClaim {
  id        String   @id @default(cuid())
  missionId String
  userId    String
  claimedAt DateTime @default(now())
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId])
}

model MissionTask {
  id          String       @id @default(cuid())
  missionId   String
  title       String
  details     String?
  actionType  ActionType
  platform    Platform
  basePoints  Int          @default(10)
  createdAt   DateTime     @default(now())
  mission     Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String   @id @default(cuid())
  taskId        String
  userId        String
  proofUrl      String
  proofText     String?
  submittedAt   DateTime @default(now())
  verifiedAt    DateTime?
  isVerified    Boolean  @default(false)
  pointsAwarded Int      @default(0)
  task          MissionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EngagementEvent {
  id           String   @id @default(cuid())
  submissionId String?
  type         String
  value        Int      @default(0)
  createdAt    DateTime @default(now())
}

model Score {
  id           String   @id @default(cuid())
  userId       String
  communityId  String
  points       Int
  reason       String
  sourceId     String?
  createdAt    DateTime @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model LeaderboardSnapshot {
  id          String   @id @default(cuid())
  communityId String
  generatedAt DateTime @default(now())
  payload     Json
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
}

model ShortLink {
  id          String   @id @default(cuid())
  communityId String
  missionId   String?
  userId      String?
  code        String   @unique
  targetUrl   String
  createdAt   DateTime @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  mission     Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks      ShortLinkClick[]

  @@index([userId])
  @@index([missionId, userId])
}

model ShortLinkClick {
  id          String   @id @default(cuid())
  shortLinkId String
  referrer    String?
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())
  shortLink   ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)
}
