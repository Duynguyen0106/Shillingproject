# Copy to infra/.env.prod and edit before deploying
# docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d --build

# Public URLs (must match how users reach the app)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Host ports
WEB_PORT=3000
API_PORT=4000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=shillops

# Seed demo data on first boot (set false after initial deploy)
RUN_SEED=true
NEXT_PUBLIC_DEMO_COMMUNITY_ID=demo-community

# WalletConnect — get a free ID at https://dashboard.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: live X feed ingestion
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=
FEED_POLL_MS=60000
